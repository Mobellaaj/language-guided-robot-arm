<?xml version="1.0"?>
<robot name="learning_arm">
  <virtual_joint name="world_anchor" type="fixed" parent_frame="world" child_link="base_footprint" />
  <group name="arm"><chain base_link="base_link" tip_link="tool0" /></group>
  <!-- These bodies meet at their joints; other link pairs remain checked. -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="left_shoulder_support_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="right_shoulder_support_link" reason="Adjacent" />
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="gripper_palm_link" reason="Adjacent" />
  <disable_collisions link1="gripper_palm_link" link2="camera_link" reason="Adjacent" />
  <disable_collisions link1="gripper_palm_link" link2="left_finger_link" reason="Adjacent" />
  <disable_collisions link1="gripper_palm_link" link2="right_finger_link" reason="Adjacent" />
  <!-- The two jaws meet when fully closed; joint limits prevent overlap. -->
  <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Default" />
</robot>
