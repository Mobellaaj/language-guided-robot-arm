<?xml version="1.0"?>
<sdf version="1.10">
  <world name="arm_world">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <!-- Render camera images. -->
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.3 -1</direction>
    </light>

    <!-- Fixed RGB camera: local +X points downward after +90 deg pitch.
         Matching world and optical TF frames are published by gazebo.launch.py. -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.33 0 0.90 0 1.5707963267948966 0</pose>
      <link name="camera_link">
        <visual name="housing">
          <geometry><box><size>0.04 0.06 0.02</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="housing_collision">
          <geometry><box><size>0.04 0.06 0.02</size></box></geometry>
        </collision>
        <sensor name="overhead_rgb" type="camera">
          <pose>0.021 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>/overhead_camera/image_raw</topic>
          <camera>
            <optical_frame_id>overhead_camera_optical_frame</optical_frame_id>
            <camera_info_topic>/overhead_camera/camera_info</camera_info_topic>
            <horizontal_fov>1.0472</horizontal_fov>
            <image>
              <width>640</width><height>480</height><format>R8G8B8</format>
            </image>
            <clip><near>0.01</near><far>5.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Actual collision plane at z=0; no downloaded model assets are needed. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 4</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 4</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Known-position grasp exercise: 4 cm cube, 50 g.
         Spawn 1 mm above the ground and let gravity settle it.
         Downward grasp: base=0, shoulder=pi/3, elbow=2*pi/3.
         x = 0.11 + 0.25*sin(pi/3); the revised shoulder pivot is at z=0.17 m.
         Finger tips are nominally 15 mm above ground at this pose. -->
    <model name="red_block">
      <static>false</static>
      <pose>0.326506350946 0 0.021 0 0 0</pose>
      <link name="block_link">
        <inertial>
          <mass>0.05</mass>
          <!-- Uniform cube: each diagonal = mass * side^2 / 6, in kg m^2. -->
          <inertia>
            <ixx>0.0000133333333333333</ixx>
            <iyy>0.0000133333333333333</iyy>
            <izz>0.0000133333333333333</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="block_collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="block_visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.8 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Color and shape exercises: dimensions are metres, masses are kg.
         All objects start 1 mm above the floor and settle under gravity. -->
    <model name="green_cylinder">
      <static>false</static>
      <pose>0.33 0.085 0.026 0 0 0</pose>
      <link name="object_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.64666666667e-05</ixx>
            <iyy>1.64666666667e-05</iyy>
            <izz>1.21e-05</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="object_collision">
          <geometry>
            <cylinder>
              <radius>0.022</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="object_visual">
          <geometry>
            <cylinder>
              <radius>0.022</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.8 0.05 1</ambient>
            <diffuse>0.05 0.8 0.05 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_sphere">
      <static>false</static>
      <pose>0.33 -0.085 0.026 0 0 0</pose>
      <link name="object_link">
        <inertial>
          <mass>0.04</mass>
          <inertia>
            <ixx>1e-05</ixx>
            <iyy>1e-05</iyy>
            <izz>1e-05</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="object_collision">
          <geometry>
            <sphere>
              <radius>0.025</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="object_visual">
          <geometry>
            <sphere>
              <radius>0.025</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.05 0.1 0.85 1</ambient>
            <diffuse>0.05 0.1 0.85 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="yellow_box">
      <static>false</static>
      <pose>0.43 0.04 0.016 0 0 0.35</pose>
      <link name="object_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>8.85416666667e-06</ixx>
            <iyy>1.41666666667e-05</iyy>
            <izz>1.55208333333e-05</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="object_collision">
          <geometry>
            <box>
              <size>0.05 0.035 0.03</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="object_visual">
          <geometry>
            <box>
              <size>0.05 0.035 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.05 1</ambient>
            <diffuse>0.9 0.8 0.05 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>