<?xml version="1.0"?>
<sdf version="1.10">
  <world name="arm_world">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.3 -1</direction>
    </light>

    <!-- Actual collision plane at z=0; no downloaded model assets are needed. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>4 4</size></plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>4 4</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Known-position grasp exercise: 4 cm cube, 50 g.
         Spawn 1 mm above the ground and let gravity settle it.
         x is chosen for a feasible downward grasp with the current joint limits. -->
    <model name="red_block">
      <static>false</static>
      <pose>0.23615045 0 0.021 0 0 0</pose>
      <link name="block_link">
        <inertial>
          <mass>0.05</mass>
          <!-- Uniform cube: each diagonal = mass * side^2 / 6, in kg m^2. -->
          <inertia>
            <ixx>0.0000133333333333333</ixx>
            <iyy>0.0000133333333333333</iyy>
            <izz>0.0000133333333333333</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="block_collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1</mu><mu2>1</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="block_visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.8 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
